# Copy to ~/.dsh/discord-bridge.env and chmod 600.
DISCORD_BOT_TOKEN=
# Required: owner or allowed users; empty means the bridge refuses to start.
DSH_DISCORD_OWNER_ID=
DSH_DISCORD_WORKSPACE=/home/your-user
DSH_DISCORD_ISOLATION=user-channel
DSH_DISCORD_REQUIRE_MENTION=true
# Optional; otherwise DSH agentDefaultModel is used.
# DSH_DISCORD_PROVIDER=deepseek-official
# DSH_DISCORD_MODEL=deepseek-flash
# How long a finished turn keeps its card open for subagents that are still
# running (milliseconds; 0 disables the wait).
# DSH_DISCORD_SUBAGENT_SETTLE_MS=120000
# 给每个子代理单开 Discord 子线程（默认 true）
# DSH_DISCORD_SUBAGENT_THREADS=true
